# Copy to .env for local development.
# Neon: Dashboard → your project → Connect → copy the connection string.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Long random string. Lets the CreateSite builder push content updates to this
# site and protects the form-entries page at /_createsite/.
ADMIN_TOKEN=change-me-to-a-long-random-string

PORT=3000
